output "vpc_id_resolved" {
  description = "Dynamic runtime identification number generated by cloud layout layers."
  value       = data.aws_vpc.default_network.id
}

output "security_group_id_allocated" {
  description = "Unique resource pointer string identifier for firewall tracking structures."
  value       = aws_security_group.pipeline_sg.id
}

output "ecr_repository_endpoint_url" {
  description = "Fully qualified universal resource directory matching destination targets."
  value       = aws_ecr_repository.app_registry.repository_url
}